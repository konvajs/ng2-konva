{
  "name": "ng2-konva",
  "version": "12.1.1",
  "description": "Angular components for the Konva 2d canvas library. Build interactive graphics, design editors, and whiteboards in Angular.",
  "keywords": [
    "angular",
    "konva",
    "canvas",
    "graphics",
    "design-editor",
    "canvas-editor",
    "whiteboard",
    "transformer"
  ],
  "homepage": "https://konvajs.org/docs/angular/index.html",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/konvajs/ng2-konva.git"
  },
  "license": "MIT",
  "bugs": "https://github.com/konvajs/ng2-konva/issues",
  "module": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && ngc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "HEADLESS=false vitest",
    "preversion": "npm test",
    "version": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0 || ^22.0.0",
    "konva": "^9.3.22 || ^10.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@angular/build": "^22.1.6",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "konva": "^10.3.3",
    "rxjs": "~7.8.2",
    "typescript": "~6.0.0",
    "vitest": "^4.0.18",
    "zone.js": "~0.16.1"
  },
  "sideEffects": false
}
